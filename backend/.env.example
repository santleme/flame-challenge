# Synthetic Intelligence (SI) layer — OpenAI-compatible endpoints.
# Copy to backend/.env (loaded automatically by services/si_copilot.py).
# Everything is optional: with the services unreachable the API serves
# the deterministic offline fallback built on tactics.py + neighbors.py.

# --- LLM (chat completions) ------------------------------------------
# Local dev: 9Router gateway
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY=local-9router-key
# Model or alias configured inside 9Router ("auto" lets the router pick)
NINE_ROUTER_MODEL=auto
# Cloud (deployed API — no gateway to host, any OpenAI-compatible URL):
#   Groq:   NINE_ROUTER_BASE_URL=https://api.groq.com/openai/v1
#           NINE_ROUTER_API_KEY=<console key>
#           NINE_ROUTER_MODEL=qwen/qwen3.8-27b
#   Gemini: NINE_ROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#           NINE_ROUTER_API_KEY=<AI Studio key>
#           NINE_ROUTER_MODEL=gemini-2.5-flash

# --- STT (audio transcriptions) ---------------------------------------
# Any OpenAI-compatible /audio/transcriptions route. Local dev:
# whisper.cpp server — newer builds serve /v1/audio/transcriptions,
# others only /inference; both accept multipart `file` and return
# {"text": ...}. See docs/SI_SETUP.md.
STT_BASE_URL=http://localhost:8081/v1/audio/transcriptions
# WHISPER_CPP_URL is still honored as a legacy alias — but only when
# STT_BASE_URL is unset; the value above always wins.
# Cloud (deployed API — Groq free tier):
#   STT_BASE_URL=https://api.groq.com/openai/v1/audio/transcriptions
#   STT_API_KEY=<console key>
#   STT_MODEL=whisper-large-v3-turbo
# STT_API_KEY / STT_MODEL are only sent when set (local whisper.cpp
# needs neither).

# Optional timeouts (seconds)
# SI_LLM_TIMEOUT_S=12
# SI_STT_TIMEOUT_S=45

# CORS_ORIGINS — comma-separated frontend origins allowed to call the
# API cross-origin (default: vite dev ports). Production example:
#   CORS_ORIGINS=https://your-app.vercel.app
